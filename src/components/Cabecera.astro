---
import marca from '../assets/logo/logo-marca-claro.svg';
import { sitio } from '../config/site';

interface Props {
  /** En el inicio va transparente y superpuesta a la fotografía de la portada. */
  sobreFoto?: boolean;
}

const { sobreFoto = false } = Astro.props;
const redes = sitio.redes.filter((red) => red.url);
---

<header class:list={['cabecera', { 'sobre-foto': sobreFoto }]}>
  {/* La columna izquierda queda libre para el selector de idioma. */}
  <span class="izquierda"></span>

  <a href="/" class="logo" aria-label={sitio.nombre}>
    <img src={marca.src} alt="" width={marca.width} height={marca.height} />
  </a>

  <div class="derecha">
    <button type="button" class="boton-menu" popovertarget="menu" aria-label="Menú">
      <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true" focusable="false">
        <path d="M3 8h22M3 14h22M3 20h22" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <nav id="menu" popover="auto" class="menu" aria-label="Menú principal">
    <ul class="rotulo">
      <li><a href="/#obras">Obras</a></li>
      <li><a href="#contacto">Contacto</a></li>
      {
        redes.map((red) => (
          <li>
            <a href={red.url} target="_blank" rel="noopener">
              {red.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Al elegir un enlace de ancla el panel debe cerrarse; sin scripts sigue funcionando el resto.
  document.querySelectorAll<HTMLElement>('.menu').forEach((menu) => {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.hidePopover();
    });
  });
</script>

<style>
  .cabecera {
    --alto-cabecera: 72px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--alto-cabecera);
    padding: 0 var(--margen);
    background: var(--azul);
    color: var(--claro);
  }

  /* Sobre la portada: sin fondo propio y con un oscurecido superior para que el logo se lea. */
  .cabecera.sobre-foto {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    background: linear-gradient(180deg, rgb(13 24 40 / 0.55), rgb(13 24 40 / 0));
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
  }

  .logo img {
    width: auto;
    height: 44px;
  }

  .derecha {
    display: flex;
    justify-content: flex-end;
  }

  .boton-menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu {
    position: fixed;
    inset: var(--alto-cabecera) 0 auto 0;
    width: 100%;
    max-width: none;
    height: auto;
    margin: 0;
    padding: 8px var(--margen) 20px;
    border: 0;
    background: var(--azul);
    color: var(--claro);
  }

  .menu ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
  }

  @media (min-width: 720px) {
    .cabecera {
      --alto-cabecera: 88px;
    }

    .logo img {
      height: 52px;
    }

    .menu {
      inset: var(--alto-cabecera) 0 auto auto;
      width: 320px;
    }
  }
</style>
