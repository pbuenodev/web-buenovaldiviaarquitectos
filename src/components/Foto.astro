---
// Única puerta de entrada de las fotografías: AVIF con respaldo WebP, varios anchos
// sin superar el del archivo de origen, dimensiones declaradas y carga diferida.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Espacio que ocupa la foto en pantalla, para que el navegador elija el ancho. */
  sizes: string;
  /** Carga inmediata y con prioridad. Solo para la primera lámina del carrusel. */
  prioritaria?: boolean;
  /** Ancho máximo que se genera. Solo el carrusel, a pantalla completa, lo sube de 1600. */
  anchoMaximo?: number;
  /** Deja las fuentes en atributos `data-` para que un script las active más tarde. */
  aplazada?: boolean;
  class?: string;
}

const ANCHOS = [480, 800, 1200, 1600, 2000, 2560];
const ANCHO_MAXIMO = 1600;
const CALIDAD = { avif: 50, webp: 72 } as const;

const { src, alt, sizes, prioritaria = false, anchoMaximo = ANCHO_MAXIMO, aplazada = false, class: clase } = Astro.props;

const mayor = Math.min(src.width, anchoMaximo);
const anchos = [...new Set([...ANCHOS.filter((ancho) => ancho < mayor), mayor])];

const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) =>
    getImage({ src, format, width: mayor, widths: anchos, quality: CALIDAD[format] }),
  ),
);
const alto = Math.round((mayor * src.height) / src.width);
const atributo = aplazada ? 'data-srcset' : 'srcset';
---

<picture class={clase}>
  <source type="image/avif" sizes={sizes} {...{ [atributo]: avif!.srcSet.attribute }} />
  <source type="image/webp" sizes={sizes} {...{ [atributo]: webp!.srcSet.attribute }} />
  <img
    {...aplazada ? { 'data-src': webp!.src } : { src: webp!.src }}
    alt={alt}
    width={mayor}
    height={alto}
    loading={prioritaria ? 'eager' : 'lazy'}
    fetchpriority={prioritaria ? 'high' : undefined}
    decoding="async"
  />
</picture>
