---
import { sitio } from '../config/site';
import type { LaminaDelSitio } from '../lib/obras';
import Foto from './Foto.astro';

interface Props {
  laminas: LaminaDelSitio[];
  /** Segundos entre fotografías. */
  segundos?: number;
}

const { laminas, segundos = 5 } = Astro.props;
---

<section class="portada" aria-label="Portada" data-portada data-segundos={segundos}>
  {
    laminas.map(({ obra, foto }, i) => (
      <div class="lamina" data-lamina data-activa={i === 0 ? '' : undefined} aria-hidden={i === 0 ? 'false' : 'true'}>
        {/* Solo la primera foto se pide al abrir; el script activa las demás antes de su turno. */}
        <Foto src={foto.imagen} alt={obra.nombre} sizes="(max-aspect-ratio: 4/3) 150vh, 100vw" prioritaria={i === 0} anchoMaximo={2560} aplazada={i > 0} />
      </div>
    ))
  }
  <div class="velo"></div>

  <div class="marca">
    <h1 class="titular nombre">Bueno Valdivia<br /><span class="sub">Arquitectos</span></h1>
    <ul class="rotulo integrantes">
      {sitio.integrantes.map((integrante) => <li>{integrante}</li>)}
    </ul>
  </div>

  <a href="#obras" class="bajar" aria-label="Ver las obras">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
      <path d="M12 4v16m0 0-6-6m6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.2" />
    </svg>
  </a>
</section>

<script>
  import { iniciarPortada } from '../scripts/portada';

  document.querySelectorAll<HTMLElement>('[data-portada]').forEach(iniciarPortada);
</script>

<style>
  .portada {
    position: relative;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    background: var(--azul);
    color: var(--claro);
  }

  .lamina {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.8s ease-in-out;
  }

  .lamina[data-activa] {
    opacity: 1;
  }

  .lamina :global(picture),
  .lamina :global(img) {
    width: 100%;
    height: 100%;
  }

  .lamina :global(img) {
    object-fit: cover;
  }

  /* Un azul uniforme junta los tonos de las fotos; el degradado sostiene el título. */
  .velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(13 24 40 / 0) 40%, rgb(13 24 40 / 0.55) 100%),
      rgb(13 24 40 / 0.4);
  }

  /* Anclado abajo, donde el degradado del velo es más oscuro. */
  .marca {
    position: absolute;
    inset: auto 0 12svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 0 var(--margen);
    text-align: center;
  }

  .nombre {
    font-size: var(--titulo-l);
    line-height: 0.95;
  }

  /* "Arquitectos" a la mitad de "Bueno Valdivia". */
  .sub {
    display: block;
    margin-top: 0.2em;
    font-size: 0.5em;
  }

  .integrantes {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Texto pequeño sobre fotografía: el halo azul asegura 4,5:1 aunque caiga sobre una zona clara. */
    text-shadow: 0 0 10px rgb(13 24 40 / 0.6);
  }

  @media (min-width: 720px) {
    .marca {
      gap: 28px;
    }
  }

  .bajar {
    position: absolute;
    inset: auto 0 20px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0 auto;
    color: var(--gris-foto);
  }

  @media (prefers-reduced-motion: reduce) {
    .lamina {
      transition: none;
    }
  }
</style>
