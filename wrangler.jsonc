// Despliegue en Cloudflare Workers como sitio estático: publica `dist/` tal cual.
// Con este archivo presente, `wrangler deploy` no intenta configurar Astro con un adaptador
// de servidor, que este sitio no necesita.
{
  // Debe coincidir con el nombre del proyecto en el panel de Cloudflare.
  "name": "web-buenovaldiviaarquitectos",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Las direcciones que no existen responden con `dist/404.html` y código 404.
    "not_found_handling": "404-page"
  }
}
